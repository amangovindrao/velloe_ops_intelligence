# Copy to .env to configure. With nothing set, the system runs in deterministic
# demo mode (MOCK_MODE=auto -> mock). Real environment variables override .env.

# ---------------- LLM (optional) ----------------
# OmniRoute (self-hosted OpenAI-compatible gateway): npm install -g omniroute ; omniroute
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=
# LLM_MODEL=auto/best-free
# LLM_TIMEOUT_SECONDS=12

# Fallback provider, tried when the primary fails (any OpenAI-compatible endpoint).
# Google Gemini free tier - comma-separated models are tried in order:
# LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest
# LLM_FALLBACK_TIMEOUT_SECONDS=15
# A failed provider is skipped for this many seconds:
# LLM_COOLDOWN_SECONDS=120

# Ollama (local): ollama pull qwen2.5:7b
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# LM Studio (local): start the server in the Developer tab
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=<model id shown in LM Studio>

# Anthropic (requires: pip install anthropic)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

MOCK_MODE=auto
LLM_TIMEOUT_SECONDS=90

# ---------------- Orchestrator limits ----------------
MAX_STEPS=120
MAX_SECONDS=300
MAX_LLM_CALLS=12
MAX_REVISIONS=2

# ---------------- Scout reliability ----------------
SCOUT_MAX_ATTEMPTS=3
SCOUT_TIMEOUT_SECONDS=1.5
WEATHER_TIMEOUT_SECONDS=8
SCOUT_BACKOFF_SECONDS=0.3

# ---------------- Dashboard ----------------
HOST=127.0.0.1
PORT=8000
DEMO_STEP_DELAY_SECONDS=0.25
