#Uploading this just for COde submission process, so it work properly for now, in future i will delete this env file


# Local secrets - do not commit or share. Real environment variables override these values.

# Primary LLM: OmniRoute (self-hosted OpenAI-compatible gateway), free-model combo only
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=sk-6aba76d6307381c2-668fc3-4063b492
LLM_MODEL=auto/best-free
# fail fast: OmniRoute's free combo can take ~20 s to report that no upstream is available
LLM_TIMEOUT_SECONDS=12

# Fallback LLM: Google Gemini free tier (OpenAI-compatible endpoint), fastest Flash-Lite models first
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=AQ.Ab8RN6IsVZhev3ypyDSU8gPf98oMjocu7_bpo5MOkgn4685xlQ
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest
LLM_FALLBACK_TIMEOUT_SECONDS=15

# skip a failed provider for 2 minutes instead of waiting on it for every agent call
LLM_COOLDOWN_SECONDS=120
MOCK_MODE=auto

# Dashboard: port 8000 is used by another local app (clarus) and 8080 by another server, so use 8081
PORT=8081